{
  "name": "crm-photografy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev --workspace=@crm-photografy/api\" \"npm run dev --workspace=@crm-photografy/web\"",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "lint": "eslint apps packages",
    "format": "prettier --write \"apps/**/*\" \"packages/**/*\" \"*.{json,jsonc,md,mjs}\"",
    "format:check": "prettier --check \"apps/**/*\" \"packages/**/*\" \"*.{json,jsonc,md,mjs}\"",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "npm run build --workspace=@crm-photografy/shared",
    "build:api": "npm run build --workspace=@crm-photografy/api",
    "build:web": "npm run build --workspace=@crm-photografy/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.47.0",
    "typescript": "~5.9.3"
  }
}
