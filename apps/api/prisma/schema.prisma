generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ArticleType {
  SALE
  INTERNAL_SUPPLY
}

enum MovementKind {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum AdjustmentMode {
  FINAL_STOCK
  DELTA
}

enum MovementSource {
  INITIAL_STOCK
  MANUAL
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique
  isActive       Boolean   @default(true)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  articles       Article[]

  @@index([isActive, normalizedName])
}

model Article {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String      @unique
  type           ArticleType
  categoryId     String      @db.Uuid
  initialStock   Int
  currentStock   Int
  minimumStock   Int
  isActive       Boolean     @default(true)
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements      Movement[]

  @@index([categoryId, isActive])
  @@index([isActive, normalizedName])
}

model Movement {
  id             String          @id @default(uuid()) @db.Uuid
  sequence       BigInt          @unique @default(autoincrement())
  articleId      String          @db.Uuid
  kind           MovementKind
  adjustmentMode AdjustmentMode?
  source         MovementSource
  appliedQuantity Int
  reason         String
  occurredAt     DateTime        @default(now()) @db.Timestamptz(3)
  stockBefore    Int
  stockAfter     Int
  article        Article         @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([articleId, occurredAt, sequence])
  @@index([occurredAt, sequence])
}
