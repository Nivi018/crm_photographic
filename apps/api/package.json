{
  "name": "@crm-photografy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prebuild": "npm run prisma:generate",
    "dev": "npm run build && concurrently --kill-others-on-fail \"tsc --project tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "pretest": "npm run prisma:generate",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev --name initial_inventory"
  },
  "dependencies": {
    "@crm-photografy/shared": "0.1.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.4",
    "dotenv": "^16.6.1",
    "prisma": "^7.4.2",
    "vitest": "^4.1.6"
  }
}
