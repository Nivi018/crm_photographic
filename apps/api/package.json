{
  "name": "@crm-photografy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "npm run build && concurrently --kill-others-on-fail \"tsc --project tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@crm-photografy/shared": "0.1.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^22.0.0",
    "vitest": "^4.1.6"
  }
}
